# Example only: generated by OpenWrt make defconfig for the selected branch.
# Recommended: run ./build.sh menuconfig and commit the resulting .config.
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_PACKAGE_luci=m
CONFIG_PACKAGE_luci-ssl=m
CONFIG_PACKAGE_kmod-e1000e=m
CONFIG_PACKAGE_kmod-igb=m
CONFIG_PACKAGE_kmod-ixgbe=m
CONFIG_PACKAGE_kmod-r8169=m
CONFIG_PACKAGE_kmod-usb3=m
CONFIG_PACKAGE_usbutils=m
CONFIG_PACKAGE_curl=m
CONFIG_PACKAGE_ca-bundle=m
CONFIG_PACKAGE_htop=m
CONFIG_PACKAGE_nano=m
